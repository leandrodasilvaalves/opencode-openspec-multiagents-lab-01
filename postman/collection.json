    {
      "name": "Register Order - Success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 2,\n      \"discount\": null\n    }\n  ],\n  \"paymentMethod\": \"Pix\",\n  \"discount\": null,\n  \"distanceKm\": 10.0,\n  \"idempotencyKey\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"idempotencyKey\")) {",
              "    pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "",
              "    pm.test(\"Response contains orderId\", function () {",
              "        pm.expect(body.orderId).to.be.a(\"string\").and.not.empty;",
              "    });",
              "",
              "    pm.test(\"Payment method is serialized as a string\", function () {",
              "        pm.expect(body.paymentMethod).to.eql(\"Pix\");",
              "    });",
              "",
              "    pm.collectionVariables.set(\"orderId\", body.orderId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Register Order - Replay Same Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 2,\n      \"discount\": null\n    }\n  ],\n  \"paymentMethod\": \"Pix\",\n  \"discount\": null,\n  \"distanceKm\": 10.0,\n  \"idempotencyKey\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Replay returns the same orderId\", function () {",
              "    pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get(\"orderId\"));",
              "});"
            ]
          }
        }
      ]
    },
