{
  "$schema": "https://opencode.ai/config.json",
  "product-manager": {
    "mode": "primary",
    "description": "Gerente de Produto: transforma ideias em especificações OpenSpec prontas para implementação",
    "temperature": 0.3,
    "permission": {
      "edit": "allow",
      "bash": {
        "*": "deny",
        "openspec *": "allow",
        "git status": "allow",
        "git diff": "allow",
        "git log --oneline *": "allow"
      },
      "task": {
        "explore": "allow"
      }
    }
  },
  "agent": {
    "ca-architect": {
      "mode": "primary",
      "description": "Orquestrador de features em Clean Architecture .NET",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "dotnet build *": "allow",
          "dotnet test *": "allow",
          "dotnet restore *": "allow",
          "git status": "allow",
          "git diff": "allow",
          "git log --oneline *": "allow"
        },
        "task": {
          "dotnet-*": "allow",
          "explore": "allow"
        }
      }
    },
    "dotnet-domain": {
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "dotnet build *": "allow",
          "dotnet test *": "allow"
        }
      }
    },
    "dotnet-application": {
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "dotnet build *": "allow",
          "dotnet test *": "allow"
        }
      }
    },
    "dotnet-infra": {
      "mode": "subagent",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "dotnet build *": "allow",
          "dotnet test *": "allow",
          "dotnet ef migrations add *": "allow",
          "dotnet ef migrations list": "allow"
        }
      }
    },
    "dotnet-api": {
      "mode": "subagent",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "dotnet build *": "allow",
          "dotnet test *": "allow",
          "docker compose up *": "allow",
          "docker build *": "allow"
        }
      }
    },
    "dotnet-reviewer": {
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "dotnet build *": "allow",
          "dotnet test *": "allow",
          "git status": "allow",
          "git diff": "allow",
          "git log --oneline *": "allow"
        }
      }
    }
  }
}